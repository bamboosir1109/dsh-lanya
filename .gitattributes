# 统一用 LF，避免 Windows 上提交后 diff 满屏变红
* text=auto eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.gif binary

# Preserve the upstream BSD notice byte for byte, including its final blank line.
tests/fixtures/onebot_egress/LICENSE whitespace=-blank-at-eof

# Native snapshots are hash-bound to published bytes, including CRLF and notices.
tests/fixtures/meme_qq_picker/** -text whitespace=-blank-at-eol,-blank-at-eof
tests/fixtures/qq_expression_media/LICENSE -text whitespace=-blank-at-eof
