{
  "name": "dsh-lanya",
  "version": "1.3.7",
  "description": "DSH 角色插件与本地控制台：人设、记忆、群聊、自主活动与运行维护。",
  "type": "module",
  "main": "plugin/lib/index.js",
  "exports": {
    ".": "./plugin/lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin/lib/*.js",
    "plugin/lib/*.mjs",
    "server/*.py",
    "scripts/*.py",
    "scripts/*.ps1",
    "scripts/*.cmd",
    "panel/*.html",
    "panel/*.css",
    "panel/*.js",
    "games/2048/*.html",
    "games/2048/*.js",
    "prompts/*.txt",
    "tests/*.py",
    "tests/*.mjs",
    "tests/fixtures/**/*.js",
    "tests/fixtures/**/*.mjs",
    "tests/fixtures/**/package.json",
    "tests/fixtures/**/provenance.json",
    "tests/fixtures/**/LICENSE",
    "tests/fixtures/**/*.md",
    "config/project.json",
    "install.ps1",
    "/cordis.patch.yml",
    "docs/INSTALL.md",
    "docs/ARCHITECTURE.md",
    "docs/MAINTENANCE.md",
    "docs/ROADMAP.md",
    "docs/MEMORY.md",
    "docs/DECISIONS.md",
    "docs/VOICE.md",
    "docs/CAPABILITIES.md",
    "docs/DEVLOG.md",
    "docs/ANDROID.md",
    "docs/LIMITATIONS.md",
    "docs/config.example.json",
    "docs/tunables.example.json",
    "docs/activities.example.json",
    "docs/persona.example.md",
    "docs/PATCH-qq-burst.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bamboosir1109/dsh-lanya.git"
  },
  "homepage": "https://github.com/bamboosir1109/dsh-lanya#readme",
  "bugs": {
    "url": "https://github.com/bamboosir1109/dsh-lanya/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "persona",
    "qq-bot",
    "onebot",
    "napcat",
    "bilibili",
    "llm-agent",
    "digital-life",
    "control-panel"
  ]
}
