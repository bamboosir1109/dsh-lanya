{
  "name": "dsh-lanya",
  "version": "1.4.0-dev.69",
  "description": "Modular QQ character integration kit for DSH: NapCatQQ/SnowLuma, Bilibili, GPT-SoVITS voice, revisable memory and autonomy. Companion services required.",
  "type": "module",
  "main": "plugin/lib/index.js",
  "exports": {
    ".": "./plugin/lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "plugin/lib/*.js",
    "plugin/lib/*.mjs",
    "server/*.py",
    "scripts/*.py",
    "scripts/*.mjs",
    "scripts/*.ps1",
    "scripts/*.cmd",
    "panel/*.html",
    "panel/*.css",
    "panel/*.js",
    "games/2048/*.html",
    "games/2048/*.js",
    "games/android-2048/*.java",
    "games/android-2048/AndroidManifest.xml",
    "prompts/*.txt",
    "tests/*.py",
    "tests/*.mjs",
    "tests/fixtures/**/*.js",
    "tests/fixtures/**/*.mjs",
    "tests/fixtures/**/package.json",
    "tests/fixtures/**/provenance.json",
    "tests/fixtures/bili_video_content/*.json",
    "tests/fixtures/qq_backend/*.json",
    "tests/fixtures/**/decision-policy.provenance.json",
    "tests/fixtures/**/LICENSE",
    "tests/fixtures/**/*.md",
    "config/project.json",
    "install.ps1",
    "/cordis.patch.yml",
    "docs/INSTALL.md",
    "docs/ARCHITECTURE.md",
    "docs/MAINTENANCE.md",
    "docs/ROADMAP.md",
    "docs/MEMORY.md",
    "docs/DECISIONS.md",
    "docs/VOICE.md",
    "docs/CAPABILITIES.md",
    "docs/FUNCTIONAL-AUDIT.md",
    "docs/DEVLOG.md",
    "docs/ANDROID.md",
    "docs/LIMITATIONS.md",
    "docs/config.example.json",
    "docs/tunables.example.json",
    "docs/persona.example.md",
    "docs/PATCH-qq-burst.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/INTERACTION-RELIABILITY.md",
    "docs/QQ-BACKENDS.md",
    "docs/STORE.md",
    "docs/INTEGRATIONS.md",
    "docs/index.html",
    "docs/assets/*",
    "screenshots.json"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bamboosir1109/dsh-lanya.git"
  },
  "homepage": "https://bamboosir1109.github.io/dsh-lanya/",
  "bugs": {
    "url": "https://github.com/bamboosir1109/dsh-lanya/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-companion",
    "persona",
    "qq-bot",
    "onebot",
    "napcat",
    "snowluma",
    "bilibili",
    "llm-agent",
    "digital-life",
    "control-panel",
    "gpt-sovits",
    "memory",
    "autonomy",
    "voice"
  ]
}
