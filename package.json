{
  "name": "dsh-lanya",
  "version": "1.3.3",
  "description": "一只住在 QQ 群里的狼：人设注入 + 长期记忆 + 表情包情绪分类 + 自主刷 B 站 + 14 页可视化控制台。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "panel.html",
    "panel-server.py",
    "state.ps1",
    "budget.ps1",
    "cleanup-tasks.ps1",
    "cleanup-tasks.cmd",
    "tunables.example.json",
    "config.example.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bamboosir1109/dsh-lanya.git"
  },
  "homepage": "https://github.com/bamboosir1109/dsh-lanya#readme",
  "bugs": {
    "url": "https://github.com/bamboosir1109/dsh-lanya/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "persona",
    "qq-bot",
    "onebot",
    "napcat",
    "bilibili",
    "llm-agent",
    "digital-life",
    "control-panel"
  ]
}